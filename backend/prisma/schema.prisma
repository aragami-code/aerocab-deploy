generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                  String?             @unique
  name                   String?
  email                  String?
  role                   UserRole            @default(passenger)
  status                 UserStatus          @default(active)
  avatarUrl              String?             @map("avatar_url")
  language               String              @default("fr")
  defaultPaymentMethod   String?             @map("default_payment_method")
  fcmToken               String?             @map("fcm_token")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  googleId               String?             @unique @map("google_id")
  referralCode           String?             @unique @map("referral_code")
  referredBy             String?             @map("referred_by") @db.Uuid
  referrer               User?               @relation("Referrals", fields: [referredBy], references: [id])
  referrals              User[]              @relation("Referrals")

  // ── KYC Passager (F1) ─────────────────────────────────────────────────────
  kycStatus              KycStatus           @default(not_started) @map("kyc_status")
  kycVerifiedAt          DateTime?           @map("kyc_verified_at")

  // ── Fidélité (F8) ─────────────────────────────────────────────────────────
  loyaltyTier            LoyaltyTierLevel    @default(bronze) @map("loyalty_tier")
  trustScore             Float               @default(5.0) @map("trust_score")

  // ── Pass d'accès passager ─────────────────────────────────────────────────
  passExpiresAt          DateTime?           @map("pass_expires_at")
  passType               String              @default("none") @map("pass_type")
  suspendedUntil         DateTime?           @map("suspended_until")

  // ── Localisation (international) ──────────────────────────────────────────
  countryCode            String?             @map("country_code") @db.VarChar(2)
  currency               String              @default("XAF")

  bookings               Booking[]
  driverConversations    Conversation[]      @relation("DriverConversations")
  passengerConversations Conversation[]      @relation("PassengerConversations")
  driverProfile          DriverProfile?
  flights                Flight[]
  sentMessages           Message[]
  pointsTransactions     PointsTransaction[]
  ratingsGiven           Rating[]            @relation("RatingsGiven")
  ratingsReceived        Rating[]            @relation("RatingsReceived")
  reportsReceived        Report[]            @relation("ReportsReceived")
  reportsSubmitted       Report[]            @relation("ReportsSubmitted")
  ticketMessages         TicketMessage[]
  wallet                 Wallet?
  withdrawalRequests     WithdrawalRequest[]
  promoUsages            PromoUsage[]
  adminRoles             UserAdminRole[]
  adminPermissions       UserPermission[]
  kycDocuments           KycDocument[]
  emergencyContacts      EmergencyContact[]

  @@map("users")
}

model DriverProfile {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                   @unique @map("user_id") @db.Uuid
  vehicleBrand      String                   @map("vehicle_brand")
  vehicleModel      String                   @map("vehicle_model")
  vehicleColor      String                   @map("vehicle_color")
  vehiclePlate      String                   @map("vehicle_plate")
  vehicleYear       Int?                     @map("vehicle_year")
  vehicleCategory   String?                  @map("vehicle_category")
  languages         String[]                 @default(["fr"])
  status            DriverVerificationStatus @default(pending)
  ratingAvg         Float                    @default(0) @map("rating_avg")
  ratingCount       Int                      @default(0) @map("rating_count")
  totalRides        Int                      @default(0) @map("total_rides")
  isAvailable       Boolean                  @default(false) @map("is_available")
  isOnline          Boolean                  @default(false) @map("is_online")
  score             Float                    @default(5.0) @map("score")
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?                @map("location_updated_at")
  lastActive        DateTime?                @map("last_active")
  verifiedAt        DateTime?                @map("verified_at")
  driverType        String                   @default("external") @map("driver_type")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  // ── Paiement & Retrait (F4) ───────────────────────────────────────────────
  payoutPhone          String?   @map("payout_phone")
  payoutMethod         String?   @map("payout_method")        // orange_money | mtn_momo | bank_transfer
  payoutName           String?   @map("payout_name")          // nom exact sur compte Mobile Money
  payoutVerified       Boolean   @default(false) @map("payout_verified")

  // ── Commission Cash (F4) ──────────────────────────────────────────────────
  cashDepositBalance   Float     @default(0) @map("cash_deposit_balance")
  cashCommissionDebt   Float     @default(0) @map("cash_commission_debt")
  cashRidesAllowed     Boolean   @default(true) @map("cash_rides_allowed")

  // ── Inscription (F9 + Section 5 CDC) ─────────────────────────────────────
  registrationFeePaid   Boolean   @default(false) @map("registration_fee_paid")
  registrationFeeAmount Float?    @map("registration_fee_amount")
  registrationFeePaidAt DateTime? @map("registration_fee_paid_at")
  countryCode           String?   @map("country_code") @db.VarChar(2)  // pays d'opération du chauffeur

  bookings             Booking[]
  documents            DriverDocument[]
  positions            DriverPosition[]
  bookingPayouts        BookingPayout[]
  tipTransactions       TipTransaction[]
  earningsWallet        DriverEarningsWallet?
  registrationPayment   DriverRegistrationPayment?
  countryChangeRequests CountryChangeRequest[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable, latitude, longitude])
  @@index([status])
  @@map("driver_profiles")
}

model DriverDocument {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverProfileId String         @map("driver_profile_id") @db.Uuid
  type            DocumentType
  fileUrl         String         @map("file_url")
  status          DocumentStatus @default(pending)
  rejectionReason String?        @map("rejection_reason")
  verifiedAt      DateTime?      @map("verified_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  driverProfile   DriverProfile  @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([driverProfileId, type])
  @@map("driver_documents")
}

model CountryChangeRequest {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverProfileId String        @map("driver_profile_id") @db.Uuid
  currentCountry  String        @map("current_country") @db.VarChar(2)
  requestedCountry String       @map("requested_country") @db.VarChar(2)
  reason          String
  status          String        @default("pending") // pending | approved | rejected
  adminNote       String?       @map("admin_note")
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([driverProfileId])
  @@map("country_change_requests")
}

model Flight {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  flightNumber     String?        @map("flight_number")
  airline          String?
  origin           String?
  destination      String?
  arrivalAirport   String         @map("arrival_airport")
  scheduledArrival DateTime       @map("scheduled_arrival")
  actualArrival    DateTime?      @map("actual_arrival")
  source           FlightSource   @default(manual)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  conversations    Conversation[]
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flightNumber])
  @@map("flights")
}

model Booking {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId      String         @map("passenger_id") @db.Uuid
  driverProfileId  String?        @map("driver_profile_id") @db.Uuid
  flightNumber     String?        @map("flight_number")
  departureAirport String         @map("departure_airport")
  destination      String
  vehicleType      String         @map("vehicle_type")
  paymentMethod    String         @map("payment_method")
  estimatedPrice   Float          @map("estimated_price")
  promoCode        String?        @map("promo_code")
  discountAmount   Float?         @default(0) @map("discount_amount")
  status           BookingStatus  @default(pending)
  driverEtaMinutes Int?           @default(10) @map("driver_eta_minutes")
  shareTripEnabled Boolean        @default(false) @map("share_trip_enabled")
  shareToken       String?        @unique @map("share_token")
  type             BookingType    @default(ARRIVAL)
  completedAt      DateTime?      @map("completed_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  destLat          Float?         @map("dest_lat")
  destLng          Float?         @map("dest_lng")
  pickupAddress    String?        @map("pickup_address")
  pickupLat        Float?         @map("pickup_lat")
  pickupLng        Float?         @map("pickup_lng")

  // ── Métriques course ───────────────────────────────────────────────────────
  startedAt            DateTime? @map("started_at")
  estimatedDistanceKm  Float?    @map("estimated_distance_km")
  estimatedDurationMin Int?      @map("estimated_duration_min")
  baseFare             Float?    @map("base_fare")
  airportFee           Float?    @map("airport_fee")

  forfaitId      String?  @map("forfait_id") @db.Uuid
  pricingZoneId  String?  @map("pricing_zone_id") @db.Uuid
  pricingMode    PricingMode @default(zone) @map("pricing_mode")
  forfait        Forfait?     @relation(fields: [forfaitId], references: [id])
  pricingZone    PricingZone? @relation(fields: [pricingZoneId], references: [id])

  // ── Paiement F4 ───────────────────────────────────────────────────────────
  currency           String        @default("XAF")
  operatingCountry   String        @default("CM") @map("operating_country")
  paymentStatus      PaymentStatus @default(not_required) @map("payment_status")
  tipAmount          Float         @default(0) @map("tip_amount")
  discountFromPoints Float         @default(0) @map("discount_from_points")
  isSplitPayment     Boolean       @default(false) @map("is_split_payment")
  receiptSentAt      DateTime?     @map("receipt_sent_at")
  scheduledAt        DateTime?     @map("scheduled_at")

  // ── Devise d'affichage (multi-pays) ───────────────────────────────────────
  displayCurrency    String?       @map("display_currency")      // devise vue par le passager (ex: EUR, MAD)
  displayAmount      Float?        @map("display_amount")         // montant converti affiché au passager
  exchangeRateUsed   Float?        @map("exchange_rate_used")     // taux XAF→displayCurrency au moment de la réservation

  driverProfile    DriverProfile? @relation(fields: [driverProfileId], references: [id])
  passenger        User           @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  positions        DriverPosition[]
  paymentIntent    PaymentIntent?
  participants     BookingParticipant[]
  payout           BookingPayout?
  tips             TipTransaction[]
  receipt          RideReceipt?
  paymentLinks     PaymentLink[]

  @@index([passengerId, status])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

model Conversation {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId String             @map("passenger_id") @db.Uuid
  driverId    String             @map("driver_id") @db.Uuid
  flightId    String?            @map("flight_id") @db.Uuid
  status      ConversationStatus @default(active)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  driver      User               @relation("DriverConversations", fields: [driverId], references: [id])
  flight      Flight?            @relation(fields: [flightId], references: [id])
  passenger   User               @relation("PassengerConversations", fields: [passengerId], references: [id])
  messages    Message[]
  ratings     Rating[]

  @@unique([passengerId, driverId, flightId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @default("")
  mediaUrl       String?      @map("media_url")
  mediaType      String?      @map("media_type")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Rating {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId     String       @map("from_user_id") @db.Uuid
  toUserId       String       @map("to_user_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  // F5.5 — Un rating par booking (au lieu d'un seul par conversation).
  // Un même passager+driver peut avoir 10 courses dans la même conversation et chacune notée.
  bookingId      String?      @map("booking_id") @db.Uuid
  score          Int
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  fromUser       User         @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser         User         @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@unique([fromUserId, bookingId])
  @@index([conversationId])
  @@map("ratings")
}

model Report {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String          @map("reporter_id") @db.Uuid
  reportedId     String?         @map("reported_id") @db.Uuid
  bookingId      String?         @map("booking_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  reason         String
  status         ReportStatus    @default(open)
  resolution     String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  reported       User?           @relation("ReportsReceived", fields: [reportedId], references: [id])
  reporter       User            @relation("ReportsSubmitted", fields: [reporterId], references: [id])
  messages       TicketMessage[]

  @@map("reports")
}

model TicketMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  senderRole String   @map("sender_role")
  message    String
  imageUrl   String?  @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at")
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])

  @@map("ticket_messages")
}

model PointsTransaction {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      PointsTransactionType
  source    PointsSource         @default(bonus)
  points    Int
  label     String
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source])
  @@map("points_transactions")
}

model Country {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique @db.VarChar(3)
  name           String
  currency       String   @default("XAF")
  accessPrice    Int      @default(2500) @map("access_price")
  accessDuration Int      @default(48) @map("access_duration")
  airports       Json     @default("[]")
  paymentMethods Json     @default("[]") @map("payment_methods")
  isActive       Boolean  @default(true) @map("is_active")
  flagEmoji        String?       @map("flag_emoji")
  phonePrefix      String?       @map("phone_prefix")
  currencySymbol   String?       @map("currency_symbol")
  currencyDecimals Int           @default(0) @map("currency_decimals")
  pointFxRate      Float         @default(1) @map("point_fx_rate")
  defaultLanguage  String        @default("fr") @map("default_language")
  status           CountryStatus @default(active)
  isDefault        Boolean       @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Wallet {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @unique @map("user_id") @db.Uuid
  balance   Float         @default(0)
  currency  String        @default("XAF")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId  String            @map("wallet_id") @db.Uuid
  amount    Float
  type      TransactionType
  status    TransactionStatus @default(pending)
  reference String?           @unique
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")
  wallet    Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model WithdrawalRequest {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  amount        Float
  currency      String                  @default("XAF")
  method        WithdrawalMethod
  mobileNumber  String                  @map("mobile_number")
  status              WithdrawalStatus        @default(pending)
  adminNote           String?                 @map("admin_note")
  processedAt         DateTime?               @map("processed_at")
  disbursementStatus  String?                 @map("disbursement_status")
  createdAt           DateTime                @default(now()) @map("created_at")
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("withdrawal_requests")
}

model PromoCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(20)
  discount   Int
  maxUses    Int       @default(1) @map("max_uses")
  usedCount  Int       @default(0) @map("used_count")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  usagePerUser Boolean @default(false) @map("usage_per_user")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  usages     PromoUsage[]

  @@map("promo_codes")
}

model PromoUsage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  usedAt      DateTime  @default(now()) @map("used_at")
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@map("promo_usages")
}

model Airport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iataCode    String   @unique @map("iata_code") @db.VarChar(3)
  icaoCode    String?  @unique @map("icao_code") @db.VarChar(4)
  name        String
  city        String
  country     String
  countryCode String   @map("country_code") @db.VarChar(2)
  latitude        Float
  longitude       Float
  detectionRadius Float    @default(3.0) @map("detection_radius")
  isActive    Boolean  @default(true) @map("is_active")
  isOperated  Boolean  @default(false) @map("is_operated")
  // Durée moyenne (minutes) entre l'atterrissage et la sortie effective du passager.
  // Permet un ETA chauffeur réaliste par aéroport : DLA petit → 15 min,
  // CDG ou JFK avec immigration+bagages → 40-50 min.
  exitDelayMinutes Int @default(15) @map("exit_delay_minutes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("airports")
}

model Forfait {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  airportCode     String        @map("airport_code") @db.VarChar(3)
  destinationName String        @map("destination_name")
  minDistKm       Float         @default(0)   @map("min_dist_km")
  maxDistKm       Float         @default(999) @map("max_dist_km")
  // deprecated — conservés nullable pour compatibilité avec l'ancienne migration
  destLat         Float?        @map("dest_lat")
  destLng         Float?        @map("dest_lng")
  destRadius      Float?        @default(2.0) @map("dest_radius")
  priceAmount     Float         @map("price_amount")
  currency        String        @default("XAF")
  countryCode     String        @map("country_code") @db.VarChar(2)
  vehicleTypes    String[]      @map("vehicle_types") @default([])
  bookingTypes    BookingType[] @map("booking_types") @default([])
  driverPercent   Float         @default(85) @map("driver_percent")
  companyPercent  Float         @default(15) @map("company_percent")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  bookings        Booking[]

  @@index([airportCode, isActive])
  @@index([countryCode, isActive])
  @@map("forfaits")
}

model PricingZone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  minDistKm   Float    @default(0)   @map("min_dist_km")
  maxDistKm   Float    @default(999) @map("max_dist_km")
  // Prix par type de véhicule : { "eco": 800, "standard": 1000, "confort": 1800 }
  prices      Json     @default("{}")
  currency    String   @default("XAF")
  // Aéroport auquel cette zone est liée (IATA). null = niveau pays ou global.
  // Cascade matching : airport → countryCode → global (null)
  airportIata String?  @map("airport_iata") @db.VarChar(3)
  countryCode String?  @map("country_code") @db.VarChar(2)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0)   @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt     @map("updated_at")

  bookings    Booking[]

  @@index([isActive, minDistKm])
  @@index([airportIata, isActive, sortOrder])
  @@index([countryCode, isActive, sortOrder])
  @@map("pricing_zones")
}

model DriverPosition {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  driverProfileId String        @map("driver_profile_id") @db.Uuid
  latitude        Float
  longitude       Float
  recordedAt      DateTime      @default(now()) @map("recorded_at")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([bookingId, recordedAt])
  @@map("driver_positions")
}

model Announcement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            AnnouncementType
  title           String
  body            String
  imageUrl        String?               @map("image_url")
  priority        AnnouncementPriority  @default(normal)
  ctaType         AnnouncementCtaType   @default(none) @map("cta_type")
  ctaLabel        String?               @map("cta_label")
  ctaValue        String?               @map("cta_value")
  targetApps      String[]              @default([]) @map("target_apps")
  targetCountries String[]              @default([]) @map("target_countries")
  targetTiers     String[]              @default([]) @map("target_tiers")
  startsAt        DateTime?             @map("starts_at")
  endsAt          DateTime?             @map("ends_at")
  isActive        Boolean               @default(true) @map("is_active")
  createdBy       String?               @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  reads           AnnouncementRead[]

  @@index([isActive, startsAt, endsAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  seenAt         DateTime     @default(now()) @map("seen_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

