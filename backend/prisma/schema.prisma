model PaymentLink {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token         String    @unique
  bookingId     String    @map("booking_id") @db.Uuid
  participantId String?   @map("participant_id") @db.Uuid
