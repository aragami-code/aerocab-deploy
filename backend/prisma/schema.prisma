// ── RBAC ────────────────────────────────────────────────────────────────────

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  group       String
  description String
  rolePerms   RolePermission[]
  userPerms   UserPermission[]

  @@map("permissions")
}

model AdminRole {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique  // super_admin, admin, moderator, support
  label       String
  description String           @default("")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  rolePerms   RolePermission[]
  userRoles   UserAdminRole[]

  @@map("admin_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserAdminRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_admin_roles")
}

model UserPermission {
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  granted      Boolean    @default(true)  // true = allow override, false = deny override
  grantedAt    DateTime   @default(now()) @map("granted_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model TariffSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode String?  @map("country_code")  // null = global
  data        Json
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tariff_snapshots")
}


// F5.3 — File de retry pour les reçus de course (SMS + Email).
// Job pické toutes les minutes par un cron tant que status='pending' et attempts < max.
model ReceiptJob {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  status     String   @default("pending")   // pending | sent | failed
  attempts   Int      @default(0)
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([status, attempts])
  @@map("receipt_jobs")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  userId     String?
  adminId    String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── F4 — Paiement ────────────────────────────────────────────────────────────

model PaymentIntent {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String        @unique @map("booking_id") @db.Uuid
  participantId String?       @map("participant_id") @db.Uuid
  provider      String        // orange_money_cm | mtn_cm | card | cash
  providerRef   String?       @unique @map("provider_ref")
  amount        Float
  currency      String
  amountBase    Float         @map("amount_base")
  baseCurrency  String        @map("base_currency")
  exchangeRate  Float         @default(1) @map("exchange_rate")
  status        PaymentStatus @default(pending)
  authorizedAt  DateTime?     @map("authorized_at")
  capturedAt    DateTime?     @map("captured_at")
  refundedAt    DateTime?     @map("refunded_at")
  failedAt      DateTime?     @map("failed_at")
  adminNote     String?       @map("admin_note")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([provider, status])
  @@map("payment_intents")
}

model BookingParticipant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  name            String?
  phone           String
  shareAmount     Float     @map("share_amount")
  shareCurrency   String    @map("share_currency")
  status          String    @default("pending") // pending|accepted|declined|paid|refunded
  inviteToken     String    @unique @map("invite_token")
  inviteExpiresAt DateTime  @map("invite_expires_at")
  inviteSentAt    DateTime? @map("invite_sent_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([inviteToken])
  @@map("booking_participants")
}

model BookingPayout {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String        @unique @map("booking_id") @db.Uuid
  driverProfileId  String        @map("driver_profile_id") @db.Uuid
  grossAmount      Float         @map("gross_amount")
  commissionRate   Float         @map("commission_rate")
  commissionAmount Float         @map("commission_amount")
  providerFeeRate  Float         @default(0.02) @map("provider_fee_rate")
  providerFeeAmount Float        @default(0) @map("provider_fee_amount")
  netAmount        Float         @map("net_amount")
  tipAmount        Float         @default(0) @map("tip_amount")
  currency         String        @default("XAF")
  payoutProvider   String?       @map("payout_provider")
  status           PayoutStatus  @default(pending)
  isCash           Boolean       @default(false) @map("is_cash")
  initiatedAt      DateTime?     @map("initiated_at")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverProfile    DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([driverProfileId, status])
  @@map("booking_payouts")
}

model TipTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  payerId         String    @map("payer_id") @db.Uuid
  driverProfileId String    @map("driver_profile_id") @db.Uuid
