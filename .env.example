# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://aerocab:aerocab_dev@localhost:5432/aerocab"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# ─── SMS (OTP) ───────────────────────────────────────────────
# Twilio
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM_NUMBER=""
# ou autre provider
SMS_API_KEY=""

# ─── Flights ─────────────────────────────────────────────────
AVIATIONSTACK_KEY=""

# ─── Payments (CinetPay) ─────────────────────────────────────
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# ─── Metrics (Prometheus) ────────────────────────────────────
METRICS_ENABLED=true               # false = endpoint /metrics désactivé
METRICS_PATH=/metrics              # chemin de l'endpoint
METRICS_DEFAULT_METRICS=true       # métriques Node.js par défaut (CPU, RAM, event loop)
METRICS_TOKEN=                     # token Bearer requis pour /metrics (fail-closed si vide)
METRICS_ALLOW_NO_TOKEN=false       # true = autorise /metrics sans token (réseau réellement isolé uniquement)

# ─── Monitoring (Grafana + pg_exporter) ──────────────────────
GRAFANA_ADMIN_PASSWORD="change-me-in-production"
PG_MONITOR_USER="pg_monitor"       # rôle PostgreSQL read-only (pg_monitor grant)
PG_MONITOR_PASSWORD="change-me-in-production"
